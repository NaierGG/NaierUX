# App crypto policy
# strict | compat
# In production/runtime non-dev, compat is automatically forced to strict.
NAIER_CRYPTO_POLICY=strict
NAIER_MESSAGE_KEY=replace-with-very-long-shared-message-key

# Expo runtime-compatible alternatives:
# EXPO_PUBLIC_NAIER_CRYPTO_POLICY=strict
# EXPO_PUBLIC_NAIER_SIGNALING_URL=ws://127.0.0.1:8787
# EXPO_PUBLIC_NAIER_SIGNALING_TOKEN=dev-signaling-secret

# Signaling endpoint for WebRTC adapter
NAIER_SIGNALING_URL=ws://127.0.0.1:8787
NAIER_SIGNALING_TOKEN=dev-signaling-secret
NAIER_SIGNAL_NAMESPACE=naier-mesh-v1
# 1 enables local demo fallback (in-memory), 0 keeps real network mode only.
NAIER_ALLOW_IN_MEMORY=0
# 1 enables mock call adapter fallback when media/runtime support is unavailable.
NAIER_ALLOW_MOCK_CALL=0

# Optional encrypted local storage key override (otherwise uses message/signaling key fallback).
NAIER_STORAGE_KEY=

# Optional STUN/TURN overrides for WebRTC (comma-separated URL lists).
# NAIER_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# NAIER_TURN_URLS=turn:your.turn.server:3478?transport=udp,turn:your.turn.server:3478?transport=tcp
# NAIER_TURN_USERNAME=
# NAIER_TURN_CREDENTIAL=

# Signaling server settings
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8787
SIGNAL_AUTH_TOKEN=dev-signaling-secret
SIGNAL_PING_MS=25000
SIGNAL_MAX_PAYLOAD_BYTES=262144
SIGNAL_MAX_QUEUE_PER_PEER=200
