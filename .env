# App crypto policy
# strict | compat
# In production/runtime non-dev, compat is automatically forced to strict.
NAIER_CRYPTO_POLICY=strict

# Expo runtime-compatible alternatives:
# EXPO_PUBLIC_NAIER_CRYPTO_POLICY=strict
# EXPO_PUBLIC_NAIER_SIGNALING_URL=ws://127.0.0.1:8787
# EXPO_PUBLIC_NAIER_SIGNALING_TOKEN=dev-signaling-secret

# Signaling endpoint for WebRTC adapter
NAIER_SIGNALING_URL=ws://127.0.0.1:8787
NAIER_SIGNALING_TOKEN=dev-signaling-secret

# Signaling server settings
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8787
SIGNAL_AUTH_TOKEN=dev-signaling-secret
SIGNAL_PING_MS=25000
SIGNAL_MAX_PAYLOAD_BYTES=262144
SIGNAL_MAX_QUEUE_PER_PEER=200
