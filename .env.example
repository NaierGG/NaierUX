# App crypto policy
# strict | compat
NAIER_CRYPTO_POLICY=strict

# Required in app runtime. Keep this separate from signaling token.
NAIER_MESSAGE_KEY=replace-with-32-byte-message-key

# Signaling endpoint for WebRTC adapter
NAIER_SIGNALING_URL=ws://127.0.0.1:8787
NAIER_SIGNALING_TOKEN=replace-with-32-byte-signaling-token
NAIER_SIGNAL_NAMESPACE=naier-mesh-v1

# 1 enables local demo fallback (in-memory), 0 keeps real network mode only.
NAIER_ALLOW_IN_MEMORY=0

# Optional encrypted local storage key override.
NAIER_STORAGE_KEY=

# STUN defaults (comma-separated). Keep STUN enabled for zero-cost MVP.
NAIER_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is optional for difficult NAT environments. Disabled by default.
# NAIER_TURN_URLS=turn:your.turn.server:3478?transport=udp,turn:your.turn.server:3478?transport=tcp
# NAIER_TURN_USERNAME=
# NAIER_TURN_CREDENTIAL=

# Signaling server settings
SIGNAL_HOST=127.0.0.1
SIGNAL_PORT=8787
SIGNAL_AUTH_TOKEN=replace-with-32-byte-signaling-token
SIGNAL_PING_MS=25000
SIGNAL_MAX_PAYLOAD_BYTES=262144
SIGNAL_MAX_QUEUE_PER_PEER=200
SIGNAL_RATE_LIMIT_WINDOW_MS=10000
SIGNAL_RATE_LIMIT_MAX=80
SIGNAL_NONCE_TTL_MS=300000
SIGNAL_AUTH_TS_SKEW_MS=60000

# Expo runtime-compatible alternatives:
# EXPO_PUBLIC_NAIER_SIGNALING_URL=ws://127.0.0.1:8787
# EXPO_PUBLIC_NAIER_SIGNALING_TOKEN=replace-with-32-byte-signaling-token
# EXPO_PUBLIC_NAIER_SIGNAL_NAMESPACE=naier-mesh-v1
# EXPO_PUBLIC_NAIER_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# WARNING:
# EXPO_PUBLIC_* variables are bundled into the client and are not secrets.
# Never treat client-bundled values as confidential credentials.
